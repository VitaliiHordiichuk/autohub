DB_HOST=localhost
DB_PORT=5432
DB_NAME=autohub
DB_USER=postgres
DB_PASSWORD=
PORT=4000
AUTH_JWT_SECRET=replace-with-at-least-32-characters
AUTH_TOKEN_EXPIRES_IN=7d
TRUST_PROXY=true
SECURITY_HASH_SECRET=replace-with-an-independent-random-secret

# Optional fallback for search analytics when the local GeoIP database has no city.
# Keyless mode is limited to 1,000 requests/day; a free key raises it to 50,000/month.
IP_GEOLOCATION_ENABLED=true
IP_GEOLOCATION_TIMEOUT_MS=700
IP2LOCATION_API_KEY=

# Transactional email through the verified maka.com.ua domain in Resend
RESEND_API_KEY=
EMAIL_FROM=MAKA.com.ua <no-reply@maka.com.ua>
PASSWORD_RESET_RATE_LIMIT=5

# Telegram notifications for administrators and managers
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_POLLING_ENABLED=true
# Opt in after code review. False preserves existing bot behavior and notifications.
TELEGRAM_CATALOG_SEARCH_ENABLED=false
FRONTEND_PUBLIC_URL=http://localhost:3000

# Nova Poshta API 2.0 directory access (keep this key on the backend only)
NOVA_POSHTA_API_KEY=
NOVA_POSHTA_API_URL=https://api.novaposhta.ua/v2.0/json/

# Disable scheduled mailbox polling in local development if production credentials are reused
EMAIL_IMPORT_SCHEDULER_ENABLED=true

# Customer taxonomy classification during supplier and reviewed imports (opt-in)
CUSTOMER_TAXONOMY_IMPORT_ENABLED=false

# Customer-facing catalog cutover to customer taxonomy (opt-in)
CUSTOMER_TAXONOMY_PUBLIC_ENABLED=false

# Atomic inventory commitment during order submission requires migration 105.

# Automatic history retention (requires migration 077); daily, with restart recovery.
DATA_RETENTION_ENABLED=true

# Cloudflare R2 product image storage
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=autohub-product-images
R2_PUBLIC_BASE_URL=https://images.example.com
# Requires migration 108 and a verified public GET/HEAD route on this controlled HTTPS origin.
# Empty preserves existing direct URL delivery. Existing URLs are never mass-rewritten.
PRODUCT_IMAGE_DELIVERY_BASE_URL=
# Enable only after reviewing the dry-run. Never deletes originals or legacy direct public URLs.
PRODUCT_IMAGE_GC_ENABLED=false
PRODUCT_IMAGE_BRANDING_MODE=FULL_BRANDED
# Stage 1 is opt-in. Keep false until migration 106 and visual approval are complete.
SMART_PRODUCT_IMAGES_ENABLED=false
